# Copy this file to ".env" and fill in your own values. NEVER commit .env
PORT=5000
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/visitor_management?retryWrites=true&w=majority
# Long random string used to sign JWTs
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d
# Secret key a person must supply to register as a guard (stops residents self-promoting)
GUARD_REGISTER_KEY=replace_with_guard_registration_key
# URL of the deployed frontend — used by the backend to restrict CORS in production.
# Set this in Render dashboard after deploying to Vercel.
# Example: https://gatehouse.vercel.app
# Leave blank locally (CORS stays open for all origins during development).
FRONTEND_URL=
