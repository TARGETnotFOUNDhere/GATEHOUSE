{
  "info": {
    "name": "Visitor Management System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "residentToken",
      "value": ""
    },
    {
      "key": "guardToken",
      "value": ""
    },
    {
      "key": "residentId",
      "value": ""
    },
    {
      "key": "visitorId",
      "value": ""
    },
    {
      "key": "logId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Register Resident",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.data) pm.collectionVariables.set(\"residentId\", j.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav.demo@example.com\",\n  \"phone\": \"9876543210\",\n  \"flatNumber\": \"A-101\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. Login Resident",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "pm.collectionVariables.set(\"residentToken\", j.data.token);",
              "pm.collectionVariables.set(\"residentId\", j.data.user.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"aarav.demo@example.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. Pre-approve Visitor (resident)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "pm.collectionVariables.set(\"visitorId\", j.data._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{residentToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/visitors/preapprove",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "visitors",
            "preapprove"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rohan Verma\",\n  \"phone\": \"9123456780\",\n  \"email\": \"rohan@example.com\",\n  \"vehicleNumber\": \"MH12AB1234\",\n  \"purpose\": \"Family visit\",\n  \"expectedDate\": \"2026-10-10\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
